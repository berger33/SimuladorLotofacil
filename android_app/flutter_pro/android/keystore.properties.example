# Copiar para android/key.properties e preencher com senhas reais
# NUNCA commitar key.properties com senhas reais - está no .gitignore

storePassword=SUA_SENHA_FORTE_AQUI_123
keyPassword=SUA_SENHA_FORTE_AQUI_123
keyAlias=upload
storeFile=/home/user/lotofacil-upload-keystore.jks

# Como gerar keystore:
# keytool -genkey -v -keystore ~/lotofacil-upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# Guardar keystore em local seguro + backup 1Password
# Se perder keystore, não consegue mais atualizar app na Play Store!
